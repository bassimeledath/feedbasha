{
  "name": "feedbasha",
  "version": "0.6.0",
  "private": true,
  "description": "Karen: target-first voice and text feedback capture for React apps.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./whisper": {
      "types": "./dist/whisper.d.ts",
      "import": "./dist/whisper.js"
    }
  },
  "files": [
    "dist",
    "OFL-Instrument-Sans.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "react",
    "feedback",
    "voice",
    "stt",
    "coding-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "react-grab": "0.1.48"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@types/node": "^22.20.1",
    "happy-dom": "^20.12.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
